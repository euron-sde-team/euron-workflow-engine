# Real AWS resources for `make up-aws`. Values come from the Terraform outputs of
# infra/terraform/envs/aws-dev (or your own key, bucket, queues and SES identity).
AWS_REGION=us-east-1
KMS_KEY_ID=alias/wfe-dev-vault
WORKFLOW_DATA_BUCKET=wfe-dev-workflow-data
SQS_ALLOWED_QUEUES=wfe-dev-order-events
# A verified SES identity (domain or address) in the same region.
MAIL_FROM=Euron WorkflowEngine <automations@example.com>

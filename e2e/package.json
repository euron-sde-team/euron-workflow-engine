{
  "name": "@wfe/e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Browser end-to-end tests, the QA crawl and README screenshots for WorkflowEngine.",
  "scripts": {
    "test": "playwright test --project=e2e",
    "qa": "playwright test --project=qa",
    "capture": "playwright test --project=capture && node capture/make-gif.mjs",
    "lint": "tsc --noEmit",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "gifenc": "1.0.3",
    "pngjs": "7.0.0",
    "typescript": "6.0.3"
  }
}
